# ── Site ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.example.com      # canonical URLs, sitemap, OG
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Email (contact form) — Milestone 1 ────────────────
RESEND_API_KEY=            # server only
CONTACT_INBOX=             # where contact-form messages are delivered
CONTACT_FROM=              # verified sender, e.g. "Academy <hello@yourdomain>"

# ── Supabase — Stage 2 ────────────────────────────────
# Public values (safe in the browser; data is protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=      # sb_publishable_... (or legacy NEXT_PUBLIC_SUPABASE_ANON_KEY)
# The secret / service-role key is NOT needed for Stage 2. Never add it with a NEXT_PUBLIC_ prefix.

# ── AI — Milestone 4 ──────────────────────────────────
OPENAI_API_KEY=            # server only
OPENAI_MODEL=
OPENAI_TRANSCRIBE_MODEL=
OPENAI_TTS_MODEL=

# ── Stripe — Milestone 7 ──────────────────────────────
STRIPE_SECRET_KEY=         # server only
STRIPE_WEBHOOK_SECRET=     # server only
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Analytics — Milestone 7 (loaded only after consent) ─
NEXT_PUBLIC_GA_MEASUREMENT_ID=
