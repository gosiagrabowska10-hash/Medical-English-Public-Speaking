{
  "name": "medical-speaking-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:start": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,realtime,storage-api,postgres-meta,supavisor",
    "db:reset": "supabase db reset",
    "test:rls": "bash supabase/tests/run_local.sh",
    "test:rls:supabase": "(echo 'begin;'; cat supabase/tests/rls_test.sql; echo 'rollback;') | psql \"$(npx supabase status -o env | grep '^DB_URL=' | cut -d= -f2- | tr -d '\\\"')\" -v ON_ERROR_STOP=1 -q -tA 2>&1 | grep -oE '(PASS|FAIL): .*|ERROR.*|ALL RLS TESTS COMPLETED'",
    "test:e2e": "node tests/e2e/auth-flow.cjs",
    "test:security": "node tests/e2e/api-security.cjs",
    "test:site": "node tests/e2e/site-qa.cjs",
    "check:secrets": "bash scripts/check-secrets.sh --history",
    "test:course": "node tests/e2e/course-flow.cjs",
    "test:course-security": "node tests/e2e/course-security.cjs",
    "content:generate": "tsx scripts/generate-content-sql.ts",
    "content:review": "tsx scripts/generate-lesson-review.ts",
    "content:handouts": "tsx scripts/generate-handouts.ts",
    "docs:pdf": "tsx scripts/render-doc-pdf.ts",
    "check:consistency": "tsx scripts/check-workshop-consistency.ts",
    "check:content": "tsx scripts/check-content-quality.ts",
    "check:register": "tsx scripts/build-compliance-register.ts",
    "content:workshop": "tsx scripts/generate-workshop-pack.ts",
    "test:a11y": "node tests/e2e/a11y-audit.cjs",
    "test:priority1": "node tests/e2e/priority1.cjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.80.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "marked": "^18.3.0",
    "playwright": "^1.63.0",
    "supabase": "^3.4.0",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
